{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marked-bench.local/schemas/scoring_compatibility.schema.json",
  "title": "The Marked Bench Scoring Compatibility Profile",
  "type": "object",
  "required": [
    "schema",
    "project",
    "benchmark_family",
    "release_id",
    "repository_url",
    "release_url",
    "purpose",
    "default_track",
    "vector_count",
    "tracks",
    "scoring_contract",
    "vectors"
  ],
  "properties": {
    "schema": {
      "const": "marked_bench.scoring-compatibility.v1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_family": {
      "type": "string",
      "minLength": 1
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_url": {
      "type": "string",
      "minLength": 1
    },
    "release_url": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "default_track": {
      "type": "string",
      "minLength": 1
    },
    "vector_count": {
      "type": "integer",
      "minimum": 1
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "scoring_contract": {
      "$ref": "#/$defs/scoring_contract"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/vector"
      }
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "required": [
        "name",
        "suite_id",
        "suite_version",
        "suite_hash",
        "case_count"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "suite_id": {
          "type": "string",
          "minLength": 1
        },
        "suite_version": {
          "type": "string",
          "minLength": 1
        },
        "suite_hash": {
          "type": "string",
          "minLength": 1
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scoring_contract": {
      "type": "object",
      "required": [
        "compare_only_same_suite_hash",
        "prediction_order_is_ignored",
        "all_case_ids_required_once",
        "overall_score_weights",
        "detector_score_semantics"
      ],
      "properties": {
        "compare_only_same_suite_hash": {
          "const": true
        },
        "prediction_order_is_ignored": {
          "const": true
        },
        "all_case_ids_required_once": {
          "const": true
        },
        "overall_score_weights": {
          "$ref": "#/$defs/score_weights"
        },
        "detector_score_semantics": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "score_weights": {
      "type": "object",
      "required": [
        "contradiction_macro_f1",
        "type_accuracy",
        "binary_detection_f1",
        "coverage_index"
      ],
      "properties": {
        "contradiction_macro_f1": {
          "type": "number"
        },
        "type_accuracy": {
          "type": "number"
        },
        "binary_detection_f1": {
          "type": "number"
        },
        "coverage_index": {
          "type": "number"
        }
      }
    },
    "vector": {
      "type": "object",
      "required": [
        "name",
        "suite",
        "input_predictions",
        "expected_summary"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "suite": {
          "type": "string",
          "minLength": 1
        },
        "input_predictions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/prediction"
          }
        },
        "expected_summary": {
          "$ref": "#/$defs/expected_summary"
        }
      }
    },
    "prediction": {
      "type": "object",
      "required": [
        "case_id",
        "predicted",
        "detector_score",
        "rationale",
        "evidence"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "predicted": {
          "type": "string",
          "minLength": 1
        },
        "detector_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "expected_summary": {
      "type": "object",
      "required": [
        "suite_id",
        "suite_version",
        "suite_hash",
        "case_count",
        "overall_score",
        "type_accuracy",
        "contradiction_macro_f1",
        "binary_detection_f1",
        "coverage_index",
        "calibration_brier_score",
        "calibration_ece",
        "failure_count",
        "failure_case_ids",
        "confusion_matrix"
      ],
      "properties": {
        "suite_id": {
          "type": "string",
          "minLength": 1
        },
        "suite_version": {
          "type": "string",
          "minLength": 1
        },
        "suite_hash": {
          "type": "string",
          "minLength": 1
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "overall_score": {
          "type": "number"
        },
        "type_accuracy": {
          "type": "number"
        },
        "contradiction_macro_f1": {
          "type": "number"
        },
        "binary_detection_f1": {
          "type": "number"
        },
        "coverage_index": {
          "type": "number"
        },
        "calibration_brier_score": {
          "type": "number"
        },
        "calibration_ece": {
          "type": "number"
        },
        "failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "failure_case_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confusion_matrix": {
          "type": "object"
        }
      }
    }
  }
}
